<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default allows cleartext so per-node allowCleartext enforcement in OkHttp/protocol layer
         controls LAN http:// servers vs HTTPS servers cleanly. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
